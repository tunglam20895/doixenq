# Supabase is the primary database. All three values below are server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BACKEND_SECRET=
ADMIN_URL=
# Run npm run setup to create local credentials and sample-data SQLite database.
# SQLite is only a legacy local-development fallback when Supabase is not configured.
DATABASE_URL=
AUTH_SECRET=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_URL=https://www.doixenq.com
CRON_SECRET=
DEMO_DATA=true

# Optional self-hosted Photon endpoint for search without Google keys.
PHOTON_URL=https://photon.komoot.io

# Optional Vietnam-focused address search (server-only). Autocomplete/Place/Reverse v4.
VIETMAP_API_KEY=
